{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hopeless-soul/Profesia-job-monitor/schemas/jobs.schema.json",
  "title": "Profesia jobs store",
  "description": "De-duplicated Profesia.sk job offers. Jobs are unique by `id`.",
  "type": "object",
  "required": ["schema_version", "updated_at", "jobs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date-time", "description": "UTC time of the last write." },
    "jobs": {
      "type": "array",
      "description": "Sorted by first_seen, newest first.",
      "items": { "$ref": "#/$defs/Job" }
    }
  },
  "$defs": {
    "Job": {
      "type": "object",
      "required": ["id", "title", "url", "company", "company_id", "location", "salary", "labels", "posted_text", "first_seen", "last_seen"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1, "description": "Profesia offer ID (from /O<id> URLs). Unique key." },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "description": "Canonical detail URL without search_id." },
        "company": { "type": ["string", "null"] },
        "company_id": { "type": ["integer", "null"], "description": "Profesia company ID (from /C<id> URLs), when the card links to a company page." },
        "location": { "type": ["string", "null"] },
        "salary": { "oneOf": [{ "$ref": "#/$defs/Salary" }, { "type": "null" }] },
        "labels": { "type": "array", "items": { "type": "string" }, "description": "Non-salary card labels, e.g. 'Zabezpečená doprava'." },
        "posted_text": { "type": ["string", "null"], "description": "Relative posting time as shown, e.g. 'Pred 2 týždňami'." },
        "first_seen": { "type": "string", "format": "date-time", "description": "UTC time this offer was first scraped. Never changes." },
        "last_seen": { "type": "string", "format": "date-time", "description": "UTC time this offer was last scraped." }
      }
    },
    "Salary": {
      "type": "object",
      "required": ["raw", "min", "max", "currency", "period"],
      "additionalProperties": false,
      "description": "Structured fields are null when `raw` is in an unrecognised format.",
      "properties": {
        "raw": { "type": "string", "description": "Label text as shown, e.g. 'Od 3 900 EUR/mesiac'." },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"], "description": "Null for open-ended 'Od X' salaries." },
        "currency": { "enum": ["EUR", "CZK", null] },
        "period": { "enum": ["month", "hour", null] }
      }
    }
  }
}
